# Auto-detect text files and normalize line endings on commit
* text=auto

# Enforce LF line endings for JavaScript and project source files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
